# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/fairfund

# JWT Authentication Secret
JWT_SECRET=your_jwt_super_secret_key_here

# Safaricom Daraja M-Pesa API Credentials
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_PASSKEY=your_daraja_lipa_na_mpesa_passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# M-Pesa B2C Loan Disbursement Credentials
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_CERT_PATH=server/certs/sandbox.cer
MPESA_SECURITY_CREDENTIAL=
